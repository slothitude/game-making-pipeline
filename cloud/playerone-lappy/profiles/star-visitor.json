{
  "game": "star-visitor",
  "url": "https://retromonkey.com.au/games/star-visitor/",
  "source": "games-src/star-visitor (scripts/player.gd, main.gd, project.godot [input])",
  "viewport": [960, 540],
  "orientation": "landscape",
  "input_classes": ["key", "pad"],
  "controls": {
    "keys": {
      "a / ArrowLeft": "move_left",
      "d / ArrowRight": "move_right",
      "w / ArrowUp": "move_up (aim up)",
      "s / ArrowDown": "move_down (duck / aim down / dismount+drop)",
      "x / k": "jump (is_action_just_pressed — needs a clean down/up edge)",
      "z / j": "fire (held = weapon.charge; release fires)",
      "r / Enter": "retry — reload_current_scene from the game-over overlay"
  },
    "touch": "NO touch handling — main.gd's _unhandled_input only reads the 'retry' action; PlayerOne must use the keyboard (or gamepad) lane here. Page.mouse gestures will not steer this game",
    "pad": "no joypad events in the [input] map, so the shim's pad reaches the page but Godot maps it to nothing — keyboard is the lane"
  },
  "touch_zones": {
    "centre": [480, 270]
  },
  "keys_map": {"move_left": "a|ArrowLeft", "move_right": "d|ArrowRight", "move_up": "w|ArrowUp", "move_down": "s|ArrowDown", "jump": "x|k", "fire": "z|j", "retry": "r|Enter"},
  "intents": {
    "start": {"gesture": "combo", "args": {"children": [
      {"gesture": "key", "args": {"name": "Enter", "down_ms": 80}},
      {"gesture": "key", "args": {"name": "x", "down_ms": 120}}]}},
    "confirm": {"gesture": "key", "args": {"name": "Enter", "down_ms": 100}},
    "retry": {"gesture": "key", "args": {"name": "r", "down_ms": 100}},
    "fire": {"gesture": "key", "args": {"name": "z", "down_ms": 350}},
    "jump": {"gesture": "key", "args": {"name": "x", "down_ms": 90}},
    "duck": {"gesture": "key", "args": {"name": "s", "down_ms": 400}},
    "dodge_left": {"gesture": "key", "args": {"name": "a", "down_ms": 400}},
    "dodge_right": {"gesture": "key", "args": {"name": "d", "down_ms": 400}},
    "dodge_up": {"gesture": "key", "args": {"name": "w", "down_ms": 300}},
    "dodge_down": {"gesture": "key", "args": {"name": "s", "down_ms": 300}},
    "left": {"gesture": "key", "args": {"name": "a", "down_ms": 300}},
    "right": {"gesture": "key", "args": {"name": "d", "down_ms": 300}},
    "up": {"gesture": "key", "args": {"name": "w", "down_ms": 250}},
    "down": {"gesture": "key", "args": {"name": "s", "down_ms": 250}},
    "advance": {"gesture": "key", "args": {"name": "d", "down_ms": 500}},
    "retreat": {"gesture": "key", "args": {"name": "a", "down_ms": 500}},
    "fire_up": {"gesture": "combo", "args": {"children": [
      {"gesture": "key", "args": {"name": "w", "down_ms": 60}},
      {"gesture": "key", "args": {"name": "z", "down_ms": 300}}]}}
  }
}
